            "type": "object",
            "properties": {
              "amount_id": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "min_value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "max_value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "currency_basis": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "qualifier": {
                "enum": [
                  "exact",
                  "approximately",
                  "up_to",
                  "at_least",
                  "range",
                  "unspecified",
                  "more_than"
                ]
              },
              "amount_kind": {
                "enum": [
                  "committed_total",
                  "contract_value",
                  "annual_fee",
                  "incremental_commitment",
                  "potential_expansion",
                  "purchase_price",
                  "investment_amount",
                  "other"
