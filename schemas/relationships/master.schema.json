        "effective_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "agreement_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "announced_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "announced_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "filed_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "detected_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "uniqueItems": true
        },
        "amounts": {
          "type": "array",
