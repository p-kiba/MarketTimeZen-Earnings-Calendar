            "type": "object",
            "properties": {
              "verification": {
                "enum": [
                  "candidate",
                  "needs_review",
                  "approved_manual",
                  "approved_rule",
                  "rejected",
                  "withdrawn"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "verification",
              "evidence_ids"
            ],
            "additionalProperties": false
          }
        },
        "supersedes_event_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "event_id",
        "deal_id",
        "relationship_ids",
        "event_type",
        "effective_date",
        "agreement_date",
        "announced_at",
        "announced_date",
        "filed_date",
        "detected_at",
        "evidence_ids",
        "amounts",
        "amount_disclosure",
        "term",
        "conditions",
        "verification",
        "verification_metadata",
        "field_verification",
        "supersedes_event_id"
