          "required": [
            "duration_value",
            "duration_unit",
            "start_basis",
            "start_date",
            "end_date",
            "renewal",
            "evidence_ids"
          ],
          "additionalProperties": false
        },
        "conditions": {
          "type": "string"
        },
        "verification": {
          "enum": [
            "candidate",
            "needs_review",
            "approved_manual",
            "approved_rule",
            "rejected",
            "withdrawn"
          ]
        },
        "verification_metadata": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "reviewer": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "rule_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "rule_version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "verified_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string"
                },
                "evidence_hashes": {
