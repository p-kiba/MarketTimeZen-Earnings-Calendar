              "verification": {
                "enum": [
                  "candidate",
                  "needs_review",
                  "approved_manual",
                  "approved_rule",
                  "rejected",
                  "withdrawn"
                ]
              },
              "original_text": {
                "type": "string",
                "maxLength": 160
              }
            },
            "required": [
              "amount_id",
              "value",
              "min_value",
              "max_value",
              "currency",
              "currency_basis",
              "qualifier",
              "amount_kind",
              "value_semantics",
              "scope",
              "payer_company_ids",
              "payee_company_ids",
              "contingent",
              "conditions",
              "evidence_ids",
              "verification"
            ],
            "additionalProperties": false
          }
        },
        "amount_disclosure": {
          "enum": [
            "disclosed",
            "not_stated_in_source",
            "explicitly_undisclosed",
            "redacted",
            "ambiguous",
            "extraction_failed"
