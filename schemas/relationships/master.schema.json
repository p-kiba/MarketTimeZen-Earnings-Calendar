              },
              "value_semantics": {
                "enum": [
                  "original_total",
                  "revised_total",
                  "increment",
                  "periodic",
                  "contingent",
                  "unknown"
                ]
              },
              "scope": {
                "type": "string"
              },
              "payer_company_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "uniqueItems": true
              },
              "payee_company_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "uniqueItems": true
              },
              "contingent": {
                "type": [
                  "boolean",
                  "null"
